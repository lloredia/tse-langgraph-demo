# Copy to .env and fill in. Never commit .env.

# auto uses OpenAI when OPENAI_API_KEY is set, otherwise the offline mock.
TSE_LLM_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leave tracing off unless you want runs sent to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tse-langgraph-demo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_DATASET=tse-qa-eval-demo

# Optional. When set, live (openai) runs replace the local draft prompt
# with this LangSmith prompt identifier, for example "tse-draft-reply".
LANGSMITH_PROMPT_REPLY=
